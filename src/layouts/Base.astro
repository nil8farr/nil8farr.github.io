---
// قلم وزیرمتن از خود سایت بارگذاری می‌شود، نه از سرور گوگل.
import '@fontsource/vazirmatn/300.css';
import '@fontsource/vazirmatn/400.css';
import '@fontsource/vazirmatn/500.css';
import '@fontsource/vazirmatn/700.css';
import '@fontsource/vazirmatn/800.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  header: {
    name: string;
    tagline: string;
    menu: string;
    menuClose: string;
    nav: { label: string; href: string }[];
    button: string;
  };
  bookingHref: string;
  footer: string;
}

const { title, description, header, bookingHref, footer } = Astro.props;
---
<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:locale" content="fa_IR">
  <meta name="theme-color" content="#F6F6F3">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body>
  <a class="skip-link" href="#main">رفتن به محتوای اصلی</a>

  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/">{header.name}<small>{header.tagline}</small></a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav"
        data-open={header.menuClose} data-closed={header.menu}>{header.menu}</button>
      <nav class="site-nav" id="site-nav" aria-label="منوی اصلی">
        {header.nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="btn" href={bookingHref}>{header.button}</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">{footer}</div>
  </footer>

  <script>
    const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
    const nav = document.getElementById('site-nav');
    if (btn && nav) {
      const set = (open: boolean) => {
        nav.classList.toggle('open', open);
        btn.setAttribute('aria-expanded', String(open));
        btn.textContent = open ? btn.dataset.open ?? '' : btn.dataset.closed ?? '';
      };
      btn.addEventListener('click', () => set(!nav.classList.contains('open')));
      nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    }
  </script>
</body>
</html>
