---
// قلم وزیرمتن از خود سایت بارگذاری می‌شود، نه از سرور گوگل.
import '@fontsource/vazirmatn/300.css';
import '@fontsource/vazirmatn/400.css';
import '@fontsource/vazirmatn/500.css';
import '@fontsource/vazirmatn/700.css';
import '@fontsource/vazirmatn/800.css';
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  header: {
    name: string;
    tagline: string;
    menu: string;
    menuClose: string;
    nav: { label: string; href: string }[];
    button: string;
    linkedin: string;
  };
  bookingHref: string;
  linkedinHref?: string;
  footer: string;
}

const { title, description, header, bookingHref, linkedinHref, footer } = Astro.props;

// منو: گزینه‌ای که آدرس ندارد پنهان است. «دفترچه» تا وقتی نوشتهٔ منتشرشده‌ای نیست پنهان می‌ماند.
// در صفحه‌های دیگر (مثل دفترچه)، لینک‌های «#بخش» به همان بخش در صفحهٔ خانه می‌روند.
const notes = await getCollection('notes', (n) => !n.data.draft);
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const navItems = header.nav
  .filter((item) => item.href && !(item.href.startsWith('/notebook') && notes.length === 0))
  .map((item) => ({ ...item, href: item.href.startsWith('#') && !isHome ? '/' + item.href : item.href }));
---
<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- امنیت: هنگام رفتن به سایت‌های دیگر، فقط دامنهٔ سایت (نه آدرس کامل صفحه) فرستاده می‌شود. -->
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:locale" content="fa_IR">
  <meta name="theme-color" content="#F6F6F3">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <script is:inline src="/js/early.js"></script>
</head>
<body>
  <a class="skip-link" href="#main">رفتن به محتوای اصلی</a>

  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/">{header.name}<small>{header.tagline}</small></a>
      <a class="btn mobile-booking" href={bookingHref} target="_blank" rel="noopener noreferrer">{header.button}</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav"
        data-open={header.menuClose} data-closed={header.menu}>{header.menu}</button>
      <nav class="site-nav" id="site-nav" aria-label="منوی اصلی">
        {navItems.map((item) => <a href={item.href} aria-current={Astro.url.pathname.startsWith(item.href) && item.href.startsWith('/') ? 'page' : undefined} {...(item.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{item.label}</a>)}
        {linkedinHref && (
          <a class="social" href={linkedinHref} target="_blank" rel="noopener noreferrer" aria-label={header.linkedin}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
            <span class="social-label">{header.linkedin}</span>
          </a>
        )}
        <a class="btn" href={bookingHref} {...(bookingHref.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{header.button}</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">{footer}</div>
  </footer>

  <script>
    const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
    const nav = document.getElementById('site-nav');
    if (btn && nav) {
      const set = (open: boolean) => {
        nav.classList.toggle('open', open);
        btn.setAttribute('aria-expanded', String(open));
        btn.textContent = open ? btn.dataset.open ?? '' : btn.dataset.closed ?? '';
      };
      btn.addEventListener('click', () => set(!nav.classList.contains('open')));
      nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    }
  </script>
</body>
</html>
