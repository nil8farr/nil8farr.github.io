---
import Base from '../layouts/Base.astro';
import { frontmatter as c } from '../copy/home.md';
import { frontmatter as error } from '../copy/404.md';

Astro.response.status = 404;
---
<Base title={error.seo.title} description={error.body} noindex header={c.header} bookingHref={c.links.booking} linkedinHref={c.links.linkedin} footer={c.footer}>
  <section class="wrap" aria-labelledby="not-found-title">
    <h1 id="not-found-title">{error.title}</h1>
    <p>{error.body}</p>
    <a class="btn" href="/">{error.home}</a>
    <p class="booking-link"><a href={c.links.booking} target="_blank" rel="noopener noreferrer">{error.booking}</a></p>
    {c.links.telegram && c.cta.fallbackLink && (
      <p>{c.cta.fallbackStart}<a href={c.links.telegram} target="_blank" rel="noopener noreferrer">{c.cta.fallbackLink}</a></p>
    )}
  </section>
</Base>

<style>
  .booking-link {
    margin-block-start: 12px;
  }
  .booking-link a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
  }
</style>
