---
import Base from '../layouts/Base.astro';
import { frontmatter as c } from '../copy/home.md';

const ext = { target: '_blank', rel: 'noopener noreferrer' };
const introParts: { text: string; em: boolean }[] = [];
let rest: string = c.hero.intro;
while (rest) {
  const hits = ((c.hero.introEmphasis ?? []) as string[]).map((e) => ({ e, i: rest.indexOf(e) })).filter((h) => h.i >= 0).sort((a, b) => a.i - b.i);
  if (!hits.length) { introParts.push({ text: rest, em: false }); break; }
  const { e, i } = hits[0];
  if (i > 0) introParts.push({ text: rest.slice(0, i), em: false });
  introParts.push({ text: e, em: true });
  rest = rest.slice(i + e.length);
}
---
<Base title={c.seo.title} description={c.seo.description} header={c.header} bookingHref={c.links.booking} linkedinHref={c.links.linkedin} footer={c.footer}>
  <section class="hero" id="hero" aria-labelledby="hero-title"><div class="wrap">
    <div class="update">
      <div class="update-body"><span class="update-icon" aria-hidden="true">↻</span><div class="hero-body">
        <h1 id="hero-title">{c.hero.line1}<span class="l2">{c.hero.line2Start}<b class="squiggle">{c.hero.line2End}</b></span></h1>
        <div class="update-actions"><a class="btn hero-btn" href="#services">{c.hero.button}</a></div>
      </div></div>
    </div>
    <div class="intro">{c.hero.photo && <img src={c.hero.photo} alt="" width="64" height="64" />}<p>{introParts.map((p) => p.em ? <strong>{p.text}</strong> : p.text)}</p></div>
  </div></section>
  <section class="problem" aria-labelledby="problem-title"><div class="wrap">
    <h2 id="problem-title">{c.problem.title}</h2><div class="two-col">
      <div>{c.problem.story.map((line: string) => <p>{line}</p>)}</div>
      <div><p>{c.problem.alertsTitle}<span class="alerts-tag">{c.problem.alertsTag}</span></p><ul class="alerts">{c.problem.symptoms.map((s: string) => <li>{s}</li>)}<li>{c.problem.alertsMore}</li></ul></div>
    </div>
  </div></section>
  <div class="bridge"><div class="wrap"><p>{c.problem.coreStart}<br /><strong>{c.problem.coreEnd}</strong></p></div></div>
  <section id="services" aria-labelledby="services-title"><div class="wrap">
    <h2 id="services-title">{c.services.title}</h2><p class="lead">{c.services.lead}</p>
    <ol class="services-list">{c.services.items.map((item: any, i: number) => (
      <li class="service-step"><span class="service-node" aria-hidden="true">{(i + 1).toLocaleString('fa-IR')}</span>
        <article class="service-card"><div class="service-summary"><span class="step-label">{c.services.stepLabels[i]}</span><h3>{item.title}</h3>{item.en && <bdi class="en" lang="en">{item.en}</bdi>}<p>{item.tagline}</p></div><ul>{item.includes.map((line: string) => <li>{line}</li>)}</ul></article>
      </li>
    ))}</ol>
    <div class="services-booking"><a class="btn" href={c.links.booking} {...ext}>{c.services.button}</a>{c.links.telegram && <p class="fallback">{c.services.fallbackStart}<a href={c.links.telegram} {...ext}>{c.cta.fallbackLink}</a></p>}</div>
  </div></section>
  <section id="why" aria-labelledby="why-title"><div class="wrap">
    <div class="proof-heading"><h2 id="why-title">{c.why.title}</h2><dl class="stats">{c.why.stats.map((s: any) => <div><dt>{s.value}</dt><dd>{s.label}</dd></div>)}</dl></div>
    <ol class="proof-stories">{c.why.steps.map((s: any) => <li><h3>{s.title}</h3><p>{s.text}</p></li>)}</ol>
    <p class="promise">{c.why.promise}</p>
    {c.why.testimonials.length > 0 && <div class="testimonials">{c.why.testimonials.map((t: any) => <figure><blockquote>{t.quote}</blockquote><figcaption>{t.name}، {t.role}</figcaption></figure>)}</div>}
  </div></section>
  <section id="faq" aria-labelledby="faq-title"><div class="wrap faq-grid">
    <div class="faq-heading"><p class="eyebrow">{c.faq.eyebrow}</p><h2 id="faq-title">{c.faq.title}</h2></div>
    <div class="faq-list">{c.faq.items.map((item: any, i: number) => <details open={i === 0}><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div>
  </div></section>
  <section class="cta" id="contact" aria-labelledby="cta-title"><div class="wrap"><div class="scrim">
    <div class="confirm"><h2 id="cta-title">{c.cta.title}</h2><p>{c.cta.text}</p><div class="actions"><a class="btn" href={c.links.booking} {...ext}>{c.cta.primary}</a>{c.links.newsletter && <a class="btn ghost" href={c.links.newsletter} {...ext}>{c.cta.secondary}</a>}</div></div>
    {c.cta.contact.length > 0 && <ul class="contact">{c.cta.contact.map((x: any) => <li><a href={x.href} {...ext}><span aria-hidden="true">{x.icon === 'email' ? '✉' : x.icon === 'telegram' ? '↗' : 'in'}</span><bdi>{x.label}</bdi></a></li>)}</ul>}
  </div></div></section>
  <aside class="mobile-sticky" aria-label={c.header.button}><span>{c.sticky.prompt}</span><a class="btn" href={c.links.booking} {...ext}>{c.header.button}</a></aside>
</Base>
