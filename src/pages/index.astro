---
import Base from '../layouts/Base.astro';
// همهٔ متن‌های این صفحه در src/copy/home.md هستند.
import { frontmatter as c } from '../copy/home.md';

const toFa = (n: number) => n.toLocaleString('fa-IR');
const hasNewsletter = Boolean(c.links.newsletter);
---
<Base
  title={c.seo.title}
  description={c.seo.description}
  header={c.header}
  bookingHref={c.links.booking}
  linkedinHref={c.links.linkedin}
  footer={c.footer}
>
  <!-- ۱. تیتر اصلی: شکل هشدار به‌روزرسانی -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <div class="update">
        <div class="update-bar">
          <span class="label">{c.hero.barLabel}</span>
          <span>{c.hero.barContext}</span>
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        </div>
        <div class="update-body">
          <div class="update-icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 4v5h-5"/></svg>
          </div>
          <div>
            <h1 id="hero-title">
              {c.hero.line1}
              <span class="l2">{c.hero.line2Start}<b>{c.hero.line2End}</b></span>
            </h1>
            <div class="update-actions">
              <a class="btn" href="#services">{c.hero.button}</a>
            </div>
          </div>
        </div>
      </div>
      <p class="intro">{c.hero.intro}</p>
    </div>
  </section>

  <!-- ۲. مسئله -->
  <section aria-labelledby="problem-title">
    <div class="wrap">
      <div class="problem-grid">
        <div class="story">
          <h2 id="problem-title">{c.problem.title}</h2>
          {c.problem.story.map((line: string) => <p>{line}</p>)}
        </div>
        <ul class="symptoms">
          {c.problem.symptoms.map((s: string) => <li>{s}</li>)}
        </ul>
      </div>
      <p class="core">{c.problem.coreStart}<span>{c.problem.coreEnd}</span></p>
    </div>
  </section>

  <!-- ۳. خدمات -->
  <section id="services" aria-labelledby="services-title">
    <div class="wrap">
      <h2 id="services-title">{c.services.title}</h2>
      <p class="lead">{c.services.lead}</p>
      <ol class="services">
        {c.services.items.map((item: any, i: number) => (
          <li class="card">
            <span class="num" aria-hidden="true">{toFa(i + 1)}</span>
            <h3>
              {item.title}
              {item.en && <span class="en"><bdi dir="ltr" lang="en">{item.en}</bdi></span>}
            </h3>
            <p class="tag">{item.tagline}</p>
            <div class="out">
              <b>{c.services.includesLabel}</b>
              <ul>{item.includes.map((x: string) => <li>{x}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
      <div class="optional">
        <div>
          <span class="badge">{c.services.optional.badge}</span>
          <h3>{c.services.optional.title}</h3>
          <p>{c.services.optional.text}</p>
        </div>
        <ul>{c.services.optional.items.map((x: string) => <li>{x}</li>)}</ul>
      </div>
      <div class="center"><a class="btn" href={c.links.booking}>{c.services.button}</a></div>
    </div>
  </section>

  <!-- ۴. چرا من -->
  <section id="why" aria-labelledby="why-title">
    <div class="wrap">
      <div class:list={['why-head', { 'has-photo': c.why.photo }]}>
        {c.why.photo && (
          <img class="portrait" src={c.why.photo} alt={c.why.photoAlt} width="600" height="600" loading="lazy" decoding="async" />
        )}
        <div class="why-title">
          <h2 id="why-title">{c.why.title}</h2>
          <dl class="stats">
            {c.why.stats.map((s: any) => <div><dt>{s.value}</dt><dd>{s.label}</dd></div>)}
          </dl>
        </div>
      </div>
      <ol class="steps">
        {c.why.steps.map((s: any, i: number) => (
          <li class="step">
            <div class="dot" aria-hidden="true">{toFa(i + 1)}</div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
      <p class="promise">{c.why.promise}</p>
      {c.why.testimonials.length > 0 && (
        <div class="testimonials">
          {c.why.testimonials.map((t: any) => (
            <figure class="testimonial">
              <blockquote>«{t.quote}»</blockquote>
              <figcaption>{t.name}، {t.role}</figcaption>
            </figure>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- ۵. دعوت: شکل پنجرهٔ تأیید (در کد یک بخش معمولی است، نه پنجرهٔ بازشو) -->
  <section class="cta" id="contact" aria-labelledby="cta-title">
    <div class="wrap">
      <div class="confirm">
        <div class="q" aria-hidden="true">؟</div>
        <h2 id="cta-title">{c.cta.title}</h2>
        <p>{c.cta.text}</p>
        <div class="actions">
          <a class="btn" href={c.links.booking}>{c.cta.primary}</a>
          {hasNewsletter && <a class="btn ghost" href={c.links.newsletter}>{c.cta.secondary}</a>}
        </div>
      </div>
      {c.cta.contact.length > 0 && (
        <ul class="contact">
          {c.cta.contact.map((x: any) => <li><a href={x.href} {...(x.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{x.label}</a></li>)}
        </ul>
      )}
    </div>
  </section>
</Base>
