---
// قالب صفحهٔ هر نوشته در دفترچه.
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { frontmatter as c } from '../../copy/home.md';
import { frontmatter as n } from '../../copy/notebook.md';

export async function getStaticPaths() {
  const notes = await getCollection('notes', (e) => !e.data.draft);
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const faDate = (d: Date) => new Intl.DateTimeFormat('fa-IR-u-ca-persian', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
---
<Base title={`${note.data.title} | ${c.header.name}`} description={note.data.description ?? n.seo.description} header={c.header} bookingHref={c.links.booking} linkedinHref={c.links.linkedin} footer={c.footer}>
  <article class="note" aria-labelledby="note-title">
    <div class="wrap">
      <header class="note-head">
        <a class="note-crumb" href="/notebook/">{n.title}</a>
        <h1 id="note-title">{note.data.title}</h1>
        <time datetime={note.data.date.toISOString().slice(0, 10)}>{faDate(note.data.date)}</time>
      </header>
      <div class="prose">
        <Content />
      </div>
      <p class="note-back"><a href="/notebook/">{n.back}</a></p>
    </div>
  </article>
</Base>
